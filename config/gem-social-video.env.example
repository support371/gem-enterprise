# GEM Enterprise social-content and trusted-video activation template.
# Copy application values into .env.local or managed Vercel environment variables.
# Copy worker values into a protected worker-only environment file.
# Never commit real credentials or approval evidence.

# Scheduled content orchestration
CONTENT_ORCHESTRATOR_WORKSPACE_ID=
CONTENT_ORCHESTRATOR_ACTOR_ID=
CONTENT_ORCHESTRATOR_CRON_SECRET=
CONTENT_ORCHESTRATOR_PROVIDERS=TIKTOK,FACEBOOK_PAGE,INSTAGRAM_PROFESSIONAL,X,NEXTDOOR
CONTENT_ORCHESTRATOR_NEXTDOOR_LOCAL_CONTEXT=
CONTENT_ORCHESTRATOR_MINIMUM_TIKTOK_ITEMS=20
CONTENT_ORCHESTRATOR_OTHER_PROVIDER_ITEMS=3

# Canonical application video-dispatch configuration
VIDEO_RENDER_DISPATCH_MODE=worker
COMFYUI_WORKFLOW_JSON=
COMFYUI_PROMPT_NODE_ID=
COMFYUI_NEGATIVE_PROMPT_NODE_ID=
COMFYUI_SEED_NODE_ID=
COMFYUI_DEFAULT_NEGATIVE_PROMPT=real company logos, credentials, private data, unreadable text, distorted faces, exploit instructions
VIDEO_RENDER_CALLBACK_SECRET=
VIDEO_RENDER_STORAGE_URL=
VIDEO_RENDER_STORAGE_KEY=
VIDEO_RENDER_STORAGE_AUTH_ORIGIN=
VIDEO_ASSET_ALLOWED_ORIGINS=

# Trusted private worker runtime
GEM_VIDEO_WORKER_API_URL=https://www.gemcybersecurityassist.com
VIDEO_RENDER_CALLBACK_SECRET=
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_BEARER_TOKEN=
VIDEO_RENDER_STORAGE_URL=
VIDEO_RENDER_STORAGE_KEY=
VIDEO_RENDER_STORAGE_BUCKET=gem-video-renders
VIDEO_RENDER_STORAGE_PREFIX=renders
VIDEO_RENDER_WORKER_STATE_DIR=.gem-video-worker
VIDEO_RENDER_WORKER_BATCH_SIZE=5
VIDEO_RENDER_WORKER_DISPATCH_LEASE_MS=120000
VIDEO_RENDER_WORKER_POLL_MS=15000
VIDEO_RENDER_WORKER_TIMEOUT_MS=30000
VIDEO_RENDER_WORKER_TRANSFER_TIMEOUT_MS=900000
VIDEO_RENDER_MAX_FILE_BYTES=1073741824

# Shared OAuth protection
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_MEDIA_LIVE_PUBLISHING_ENABLED=false

# TikTok remains inside TokMetric
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://gemcybersecurityassist.com/api/tokmetric/oauth/callback
TOKMETRIC_TOKEN_ENCRYPTION_KEY=
TOKMETRIC_TIKTOK_OAUTH_ENABLED=false
TOKMETRIC_LIVE_PUBLISHING_ENABLED=false

# Meta: Facebook Page and Instagram Professional
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_SOCIAL_SCOPES=pages_show_list pages_read_engagement pages_manage_posts instagram_basic instagram_content_publish
META_OAUTH_REDIRECT_URI=https://gemcybersecurityassist.com/api/social-media/oauth/meta/callback
META_APP_REVIEW_APPROVED=false
META_SOCIAL_OAUTH_ENABLED=false
META_SOCIAL_PUBLISHING_ENABLED=false

# X company account
X_CLIENT_ID=
X_CLIENT_SECRET=
X_SOCIAL_SCOPES=tweet.read tweet.write users.read offline.access
X_OAUTH_REDIRECT_URI=https://gemcybersecurityassist.com/api/social-media/oauth/x/callback
X_SOCIAL_OAUTH_ENABLED=false
X_SOCIAL_PUBLISHING_ENABLED=false

# LinkedIn Company
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SOCIAL_SCOPES=rw_organization_admin w_organization_social r_organization_social
LINKEDIN_API_VERSION=
LINKEDIN_OAUTH_REDIRECT_URI=https://gemcybersecurityassist.com/api/social-media/oauth/linkedin/callback
LINKEDIN_COMMUNITY_MANAGEMENT_ACCESS_APPROVED=false
LINKEDIN_SOCIAL_OAUTH_ENABLED=false
LINKEDIN_SOCIAL_PUBLISHING_ENABLED=false

# YouTube channel or Brand Account
GOOGLE_SOCIAL_CLIENT_ID=
GOOGLE_SOCIAL_CLIENT_SECRET=
YOUTUBE_SOCIAL_SCOPES=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.upload
YOUTUBE_OAUTH_REDIRECT_URI=https://gemcybersecurityassist.com/api/social-media/oauth/youtube/callback
YOUTUBE_DATA_API_AUDIT_APPROVED=false
YOUTUBE_SOCIAL_OAUTH_ENABLED=false
YOUTUBE_PUBLISHING_ENABLED=false

# Nextdoor authorized identity or business page
NEXTDOOR_CLIENT_ID=
NEXTDOOR_CLIENT_SECRET=
NEXTDOOR_SOCIAL_SCOPES=openid profile post:write post:read
NEXTDOOR_OAUTH_REDIRECT_URI=https://gemcybersecurityassist.com/api/social-media/oauth/nextdoor/callback
NEXTDOOR_PUBLISH_API_ACCESS_APPROVED=false
NEXTDOOR_OAUTH_ENABLED=false
NEXTDOOR_PUBLISHING_ENABLED=false

# Indeed is employer-feed only and must not receive general marketing content
INDEED_EMPLOYER_ID=
INDEED_JOB_FEED_URL=
INDEED_EMPLOYER_INTEGRATION_ENABLED=false
INDEED_JOB_PUBLISHING_ENABLED=false
