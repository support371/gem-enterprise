# GEM production or preview base URL.
GEM_BASE_URL=https://gemcybersecurityassist.com

# Must match the server-side VIDEO_RENDER_CALLBACK_SECRET.
VIDEO_RENDER_CALLBACK_SECRET=replace-with-a-long-random-secret

# ComfyUI is normally reachable from the same host or Docker network.
COMFYUI_BASE_URL=http://host.docker.internal:8188
# Optional when ComfyUI is behind an authenticated reverse proxy.
COMFYUI_BEARER_TOKEN=
# Host path mounted into the container at /comfy-output.
COMFYUI_OUTPUT_DIR=/comfy-output

# Supabase project and service-role credentials used only by this worker.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Dedicated public-read bucket with service-role-only write permissions.
VIDEO_ASSET_BUCKET=gem-rendered-media

VIDEO_WORKER_POLL_INTERVAL_MS=15000
VIDEO_WORKER_BATCH_SIZE=10
VIDEO_WORKER_CONCURRENCY=2
VIDEO_WORKER_HEALTH_PORT=8787
VIDEO_WORKER_REQUEST_TIMEOUT_MS=30000
