# GEM application endpoint used by the trusted worker dispatch, job feed,
# upload-verification, and automatic finalization callbacks.
GEM_VIDEO_WORKER_API_URL=https://www.gemcybersecurityassist.com
VIDEO_RENDER_CALLBACK_SECRET=replace-with-the-managed-callback-secret

# Private ComfyUI endpoint. HTTPS is required unless ComfyUI is on localhost.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_BEARER_TOKEN=

# Supabase Storage project and dedicated private render bucket.
VIDEO_RENDER_STORAGE_URL=https://your-project-ref.supabase.co
VIDEO_RENDER_STORAGE_KEY=replace-with-a-restricted-storage-credential
VIDEO_RENDER_STORAGE_BUCKET=gem-video-renders
VIDEO_RENDER_STORAGE_PREFIX=renders

# Durable local journal used after ComfyUI accepts a prompt and before GEM records
# the provider prompt ID. The systemd service supplies /var/lib automatically.
VIDEO_RENDER_WORKER_STATE_DIR=/var/lib/gem-video-render-worker

# Bounded worker operation.
VIDEO_RENDER_WORKER_BATCH_SIZE=5
VIDEO_RENDER_WORKER_DISPATCH_LEASE_MS=120000
VIDEO_RENDER_WORKER_POLL_MS=15000
VIDEO_RENDER_WORKER_TIMEOUT_MS=30000
VIDEO_RENDER_WORKER_TRANSFER_TIMEOUT_MS=900000
VIDEO_RENDER_MAX_FILE_BYTES=1073741824
