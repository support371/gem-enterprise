# GEM trusted local video render worker
# Copy to a local file outside source control and replace every placeholder.

# Private ComfyUI control endpoint.
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Optional when ComfyUI is protected by a bearer-authenticated reverse proxy.
COMFYUI_BEARER_TOKEN=
# Absolute ComfyUI output directory visible to this worker.
COMFYUI_OUTPUT_DIR=/opt/ComfyUI/output

# Deployed GEM Enterprise origin. Do not include a trailing slash.
GEM_VIDEO_WORKER_API_BASE_URL=https://gemcybersecurityassist.com
# Must exactly match VIDEO_RENDER_CALLBACK_SECRET in the GEM Enterprise runtime.
VIDEO_RENDER_CALLBACK_SECRET=replace-with-an-independent-random-secret-at-least-32-characters

# Approved Supabase storage project used for rendered media.
SUPABASE_URL=https://your-project-ref.supabase.co
# Worker-only secret. Never expose this value to a browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-supabase-service-role-key
# The bucket must exist and its uploaded objects must be reachable through the public object URL
# so GEM can perform a server-side HEAD verification.
VIDEO_RENDER_SUPABASE_BUCKET=media
VIDEO_RENDER_STORAGE_PREFIX=video-renders

# Set a stable UUID for the physical worker. Generate one once and keep it unchanged.
VIDEO_RENDER_WORKER_ID=11111111-1111-4111-8111-111111111111
VIDEO_RENDER_WORKER_STATE_FILE=.gem-video-worker/state.json
VIDEO_RENDER_WORKER_POLL_INTERVAL_MS=5000
VIDEO_RENDER_WORKER_STABILITY_DELAY_MS=1500
VIDEO_RENDER_WORKER_MAX_ATTEMPTS=12
VIDEO_RENDER_WORKER_HISTORY_LIMIT=100

# Optional local-only health server. Set to 0 to disable.
VIDEO_RENDER_WORKER_HEALTH_HOST=127.0.0.1
VIDEO_RENDER_WORKER_HEALTH_PORT=8787
